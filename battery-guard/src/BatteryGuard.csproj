<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BatteryGuard</AssemblyName>
    <RootNamespace>DigitalArts.BatteryGuard</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Shown in Windows file Properties > Details -->
    <Product>Battery Guard</Product>
    <AssemblyTitle>Battery Guard - Laptop Battery Saver</AssemblyTitle>
    <Description>Battery Guard by Digital Arts - free laptop battery alarm</Description>
    <Company>Digital Arts</Company>
    <Authors>Digital Arts</Authors>
    <Copyright>© 2026 Digital Arts. Free to use.</Copyright>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>

  </PropertyGroup>

  <!-- Linux पर बिल्ड: Mono के .NET Framework 4.8 reference assemblies (Windows पर इसकी ज़रूरत नहीं) -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
  </ItemGroup>

</Project>
